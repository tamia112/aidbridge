# --- AIDBRIDGE PROJECT MASTER GITIGNORE ---

# 1. Dependencies (Crucial to ignore for MERN stack)
node_modules/
jspm_packages/
package-lock.json
yarn.lock

# 2. Private Credentials & Environment Variables (CRITICAL)
# Never upload these to your private or public GitHub
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key

# 3. Build & Production Outputs
dist/
dist-ssr/
build/
out/
.vercel/
.render/

# 4. Logs and Debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 5. AI Service Specifics (Python / Ollama)
# Since you have a Python microservice, these must be ignored
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
bin/
lib/
include/
pip-log.txt
pip-delete-this-directory.txt

# 6. Database & Storage (Local testing)
*.db
*.sqlite
uploads/*
!uploads/.gitkeep
.history/
**/.history/
client/.history/
server/.history/
ai_service/.history/

# 7. Editor & System Directories
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.bak